# Gravity Score Sports / Stat Miner - Environment Variables
# Copy this file to .env and fill in your values.

# --- Odds API (for /books/edges/{league} - NBA, NFL, MLB) ---
# Get a free key at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here
# Optional: override base URL (default: https://api.the-odds-api.com/v4)
# ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# --- Props heat map ---
# Odds API credits to spend per day on player prop lines (1 per stat type per game).
# PROPS_DAILY_CREDIT_BUDGET=16
# Stat types to fetch, in priority order (pts, reb, ast, fg3m, pra, pr, pa, ra, stl, blk, stocks, tov)
# PROPS_MARKETS=pts,reb,ast,fg3m,pra

# --- Supabase (for storing odds & rankings) ---
# Create a project at https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# --- CORS (optional: extra frontend origins, comma-separated) ---
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
# Optional regex, e.g. to allow Vercel preview deploys:
# CORS_ORIGIN_REGEX=https://gravity-score-.*\.vercel\.app

# --- Admin ---
# Write endpoints (POST /odds, /rankings, /tracker/bets) are disabled unless this is set.
# Send it as the X-Admin-Token header.
# ADMIN_TOKEN=change-me

# --- NBA Stats ---
# No API key needed! Uses nba_api (pip install nba_api) which pulls from NBA.com.
# Basketball Gravity Scores use real data when nba_api is installed.
# Dev only: fall back to demo stats (LeBron, Curry, Giannis) when NBA.com is unreachable.
# Leave unset in production so outages return 503 instead of fake numbers.
# GRAVITY_ALLOW_MOCK=1
# Optional: route NBA.com requests through a proxy (NBA.com often blocks cloud server IPs).
# NBA_API_PROXY=http://user:pass@proxy-host:port
